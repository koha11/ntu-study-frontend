; NPM-only enforcement configuration for ntu-study-frontend
; Prevents accidental use of other package managers (yarn, pnpm, bun)

engine-strict=true
scripts-prepend-node-modules=true
legacy-peer-deps=false

; Require npm >=10.0.0 for modern dependency resolution
; This is enforced via engines field in package.json

; Documentation: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc
; This project uses npm exclusively. Do not use bun, yarn, or pnpm.
