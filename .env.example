# Backend API (NestJS). Must match the port your API listens on.
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth Web client ID (public). Same project as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# OAuth redirect URI must match exactly:
# - Google Cloud Console → Authorized redirect URIs
# - Backend GOOGLE_CALLBACK_URL (used when exchanging the auth code)
# SPA callback route in this app: /login/callback → full URL e.g. http://localhost:5173/login/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# Optional: restrict Google account picker to an organization domain (hosted domain hint)
# VITE_GOOGLE_HD=ntu.edu.sg
